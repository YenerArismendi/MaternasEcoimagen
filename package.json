{
  "name": "maternas-monorepo",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend",
    "start": "cd backend-go && ~/.local/go/bin/go run cmd/server/main.go",
    "dev": "cd backend-go && ~/.local/go/bin/go run cmd/server/main.go & npm run dev --workspace=frontend",
    "seed": "cd backend-go && ~/.local/go/bin/go run cmd/server/main.go",
    "mcp:index": "PATH=\"$HOME/.local/bin:$PATH\" codebase-memory-mcp cli index_repository --repo-path .",
    "mcp:ui": "PATH=\"$HOME/.local/bin:$PATH\" codebase-memory-mcp --ui=true"
  }
}
